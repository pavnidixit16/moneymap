# Copy to .env.local for local development. Never commit real values.
# Both values are public by design (they ship to the browser); access is enforced
# by row-level security. Find them in Supabase: Project Settings -> API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Never add a service-role / secret key here. The MVP does not need one.

# Optional: Gmail (server only, never NEXT_PUBLIC_). Leave unset and Gmail stays off.
# Set the real values only in Vercel -> Settings -> Environment Variables (docs/SETUP.md).
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_TOKEN_KEY=          # 32 random bytes, base64: openssl rand -base64 32
