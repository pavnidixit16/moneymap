# Copy to .env.local for local development. Never commit real values.
# Both values are public by design (they ship to the browser); access is enforced
# by row-level security. Find them in Supabase: Project Settings -> API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Never add a service-role / secret key here. The MVP does not need one.
